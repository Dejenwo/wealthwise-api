# ── Core ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite — zero setup):
DATABASE_URL=sqlite+aiosqlite:///./wealthwise.db

# Production (PostgreSQL on Render / Railway / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/wealthwise
DB_ECHO=false

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Advisor (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (added in Step 2) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://wealthwise.app
